{
  "schemaVersion": "2.0.0",
  "capabilityId": "servicing.open_subaccount",
  "name": "Open member sub-account",
  "description": "Sign in, find a member, open the sub-account flow, enter account details, review the request, and return the confirmation reference.",
  "version": 1,
  "status": "draft",
  "confidence": 0.9,
  "target": {
    "surfaceKind": "legacy-web",
    "appId": "member-servicing",
    "vendorProduct": "MemberServicing",
    "tenantId": "cu-a",
    "baseUrl": "http://localhost:7799",
    "entryPath": "/t/cu-a/"
  },
  "params": [
    {
      "name": "operator_id",
      "type": "string",
      "required": true,
      "redact": false,
      "description": "Operator login ID."
    },
    {
      "name": "operator_password",
      "type": "string",
      "required": true,
      "redact": true,
      "description": "Operator password."
    },
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "redact": false,
      "description": "Member ID."
    },
    {
      "name": "account_type",
      "type": "string",
      "required": true,
      "redact": false,
      "description": "Sub-account type."
    },
    {
      "name": "initial_deposit",
      "type": "string",
      "required": true,
      "redact": false,
      "description": "Initial deposit amount."
    },
    {
      "name": "account_nickname",
      "type": "string",
      "required": false,
      "redact": false,
      "description": "Optional account nickname."
    }
  ],
  "outputs": [
    {
      "name": "confirmation_ref",
      "type": "string",
      "redact": false,
