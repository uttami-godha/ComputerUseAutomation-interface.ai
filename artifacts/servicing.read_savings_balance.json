        "type": "type",
        "value": {
          "param": "operator_id"
        }
      },
      "target": {
        "description": "Operator ID field (structural).",
        "strategies": [
          {
            "kind": "css",
            "selector": "input[name=\"op\"]"
          },
          {
            "kind": "nearLabel",
            "label": "Operator ID"
          }
        ]
      }
    },
    {
      "id": "type-password",
      "intent": "Enter the operator password",
      "risk": "safe",
      "action": {
        "type": "type",
        "value": {
          "param": "operator_password"
        },
        "secret": true
      },
      "target": {
        "description": "Password field (structural); redacted param.",
        "strategies": [
          {
            "kind": "css",
            "selector": "input[name=\"pw\"]"
          },
          {
            "kind": "nearLabel",
            "label": "Password"
          }
        ]
      }
    },
    {
      "id": "click-signin",
      "intent": "Sign in",
      "risk": "safe",
      "action": {
        "type": "click"
      },
      "target": {
        "description": "Sign In button by role+name.",
        "strategies": [
          {
            "kind": "role",
            "role": "button",
            "name": "Sign In",
            "exact": false
          }
        ]
      },
      "checkpoint": {
        "text": "Member Lookup"
      }
    },
    {
      "id": "type-member",
      "intent": "Enter the member ID",
      "risk": "safe",
      "action": {
        "type": "type",
        "value": {
          "param": "member_id"
        }
      },
      "target": {
        "description": "Member ID field by role+name; label and structural selector are fallbacks.",
        "strategies": [
          {
            "kind": "role",
            "role": "textbox",
            "name": "Member ID",
            "exact": false
          },
          {
            "kind": "label",
            "text": "Member ID"
          },
          {
            "kind": "nearLabel",
            "label": "Member ID"
          },
          {
            "kind": "css",
            "selector": "input[name=\"memberId\"]"
          }
        ]
      }
    },
    {
      "id": "click-search",
      "intent": "Search for the member",
      "risk": "safe",
      "action": {
        "type": "click"
      },
      "target": {
        "description": "Search button by role+name; visible text fallback.",
        "strategies": [
          {
            "kind": "role",
            "role": "button",
            "name": "Search",
            "exact": false
          },
          {
            "kind": "text",
            "text": "Search",
            "exact": false
          }
        ]
      },
      "checkpoint": {
        "text": "Member Detail"
      }
    },
    {
      "id": "read-1",
      "intent": "Read the savings balance value",
      "risk": "safe",
      "action": {
        "type": "read"
      },
      "extractAs": "savings_balance",
      "target": {
        "description": "Legacy label:value row - the value cell adjacent to the 'Savings Balance' label. nearLabel survives structural churn; xpath is the fallback.",
        "strategies": [
          {
            "kind": "nearLabel",
            "label": "Savings Balance"
          },
          {
            "kind": "xpath",
            "selector": "/html/body/div[2]/table/tr[4]/td[2]"
          }
        ]
      }
    }
