  "globalOutcomes": [
    {
      "outcome": "SESSION_INTERSTITIAL",
      "whenTextMatches": "session was idle|do you want to continue",
      "classification": "recoverable",
      "action": "dismiss_and_continue",
      "recover": {
        "strategies": [
